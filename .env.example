# Public client configuration. These values are compiled into the app.
# The Supabase anon key is safe to ship only because Row Level Security scopes every table to auth.uid().
# Never put the Supabase service-role key or GEMINI_API_KEY in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# HTTPS MapLibre style URL. Leave empty to draw the SVG route outline only.
# If the URL contains a provider key, restrict that key to this app.
EXPO_PUBLIC_MAP_TILE_STYLE_URL=

# Edge Function secrets. Set these in the Supabase project, not in the mobile app.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
