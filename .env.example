# Public client configuration. These values are compiled into the app.
# The Supabase publishable key is safe to ship only because Row Level Security scopes every table to auth.uid().
# Never put the Supabase service-role / secret key or GEMINI_API_KEY in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# HTTPS MapLibre style URL. Leave empty to draw the SVG route outline only.
# If the URL contains a provider key, restrict that key to this app.
EXPO_PUBLIC_MAP_TILE_STYLE_URL=

# --- EAS builds ---
# Set the three EXPO_PUBLIC_* variables above as EAS project secrets / environment
# variables for every profile (development, preview, production). Do not commit real
# values. Do NOT add GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, or sb_secret_* to EAS
# mobile env — those belong only on the Supabase Edge Function / dashboard.

# Edge Function secrets. Set these in the Supabase project dashboard / secrets, not in the mobile app.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
